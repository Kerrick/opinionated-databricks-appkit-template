{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rangeStrategy": "pin",
  "automerge": false,
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "AppKit's packages are released in step, and the template pins them to one version.",
      "matchPackageNames": ["@databricks/appkit", "@databricks/appkit-ui"],
      "groupName": "AppKit",
      "rangeStrategy": "pin"
    },
    {
      "description": "echarts has to be exactly the version @databricks/appkit-ui depends on, so it moves only with the AppKit update, by hand.",
      "matchPackageNames": ["echarts"],
      "enabled": false
    },
    {
      "description": "Tools pinned in mise.toml (Node, pnpm, the Databricks CLI) are exact versions.",
      "matchManagers": ["mise"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Node is pinned in mise.toml, generic/.nvmrc and generic/mise.toml.tmpl, and the three have to name one version, so they update in one pull request. Node 22 matches the Databricks Apps runtime, so a new major waits for a decision.",
      "matchDepNames": ["node"],
      "matchDatasources": ["node-version"],
      "allowedVersions": "<23",
      "groupName": "Node.js"
    },
    {
      "description": "The libraries Chromium needs on Linux, pinned in pixi.toml to exact conda-forge versions, with pixi.lock refreshed beside them.",
      "matchManagers": ["pixi"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Actions stay pinned to a full commit digest, with the version in a comment.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node in generic/mise.toml.tmpl. The mise manager can't read the file, because the Go template conditionals make it invalid TOML.",
      "managerFilePatterns": ["/(^|/)mise\\.toml\\.tmpl$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>node) = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Python in generic/mise.toml.tmpl.",
      "managerFilePatterns": ["/(^|/)mise\\.toml\\.tmpl$/"],
      "matchStrings": ["(?:^|\\n)python = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "python",
      "packageNameTemplate": "python/cpython",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>\\S+)"
    },
    {
      "customType": "regex",
      "description": "pnpm in generic/mise.toml.tmpl.",
      "managerFilePatterns": ["/(^|/)mise\\.toml\\.tmpl$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>pnpm) = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "The Python tools in generic/mise.toml.tmpl, which mise installs from PyPI.",
      "managerFilePatterns": ["/(^|/)mise\\.toml\\.tmpl$/"],
      "matchStrings": [
        "(?:^|\\n)\"?(?:pipx:)?(?<depName>uv|pre-commit|sqlfluff|squawk-cli)\"? = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "pixi in generic/mise.toml.tmpl.",
      "managerFilePatterns": ["/(^|/)mise\\.toml\\.tmpl$/"],
      "matchStrings": ["(?:^|\\n)pixi = \\{ version = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "pixi",
      "packageNameTemplate": "prefix-dev/pixi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\S+)"
    },
    {
      "customType": "regex",
      "description": "The skills CLI that generic/.pre-commit-config.yaml runs through npx. The pre-commit manager reads only hook revisions, and this hook is a local command.",
      "managerFilePatterns": ["/(^|/)\\.pre-commit-config\\.ya?ml$/"],
      "matchStrings": ["npx (?:--yes |-y )?(?<depName>[^@\\s]+)@(?<currentValue>[0-9][^\\s]*)"],
      "datasourceTemplate": "npm"
    }
  ]
}
