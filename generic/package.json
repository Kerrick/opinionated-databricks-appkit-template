{
  "name": "{{.projectName}}",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "NODE_ENV=production exec node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "typecheck": "tsc -b",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:boundaries && pnpm run lint:structure && pnpm run lint:ast-grep && pnpm run lint:sql && pnpm run lint:sizes && pnpm run lint:triggers",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:boundaries": "tsx tools/check-boundaries.ts",
    "lint:structure": "ast-grep test && ast-grep scan",
    "lint:sql": "tsx tools/lint-sql.ts",
    "lint:sizes": "tsx tools/check-sizes.ts",
    "knip": "knip",
    "jscpd": "jscpd",
    "lint:triggers": "tsx tools/check-triggers.ts",
    "lint:fix": "oxlint --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip && pnpm run jscpd && pnpm run test && pnpm run build",
    "pretest": "pnpm run test:browsers",
    "test:browsers": "tsx tools/install-browsers.ts",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebuild": "pnpm run sync && node scripts/typegen-production.mjs",
    "predev": "pnpm run sync && pnpm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "postinstall": "tsx tools/unpack-docs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "{{.appDescription}}",
  "dependencies": {
    "@databricks/appkit": "0.103.0",
    "@databricks/appkit-ui": "0.103.0",
    "clsx": "2.1.1",
    "lucide-react": "0.546.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@ast-grep/napi": "0.37.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@fast-check/vitest": "0.5.0",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@tsconfig/strictest": "2.0.9",
    "@types/express": "5.0.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "10.4.21",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.9.0",
    "eslint": "9.39.1",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-jsdoc": "65.5.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.11.0",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "msw": "3.0.7",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "quickpickle": "1.11.2",
    "tailwindcss": "4.0.14",
    "tsdown": "0.23.1",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.9",
    "vitest-browser-react": "2.3.0"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.37.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.12.0",
    "systeminformation": "5.33.16",
    "fast-uri": "3.1.0",
    "socks": "2.8.7",
    "bare-path": "3.1.1",
    "bare-url": "2.5.2"
  }
}
