# The toolchain, pinned. `mise install` installs it; `mise x -- <command>` runs a command with it.
[tools]
# Node 22 matches the Databricks Apps runtime, and pnpm matches `packageManager` in package.json.
node = "22.23.5"
pnpm = "11.0.8"
# Python tools: sqlfluff lints config/queries, and pre-commit runs the git hook.
python = "3.13.18"
uv = "0.13.9"
pre-commit = "4.7.0"
"pipx:sqlfluff" = "4.5.0"
# Installs the libraries Chromium needs on Linux (pixi.toml), without root.
pixi = { version = "0.84.2", os = ["linux"] }
{{- if or .plugins.lakebase .plugins.database}}
# Checks Lakebase migrations for changes that lock tables or break running code.
"pipx:squawk-cli" = "2.74.0"
{{- end}}

[tasks.hooks]
description = "Install the git hooks, then restore the shared agent skills now rather than at the next checkout"
run = ["pre-commit install", "pre-commit run restore-agent-skills --hook-stage post-checkout"]
