{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tools/*.ts",
    "client/tailwind.config.ts",
    "client/postcss.config.js",
    "client/src/lib/utils.ts",
    "client/src/acl/fetch-or-throw.ts",
    "features/steps/*.{ts,tsx}",
    "vitest.mutation.config.ts"{{if .plugins.design}},
    "client/src/design/**/*.tsx"{{end}}
  ],
  "project": ["client/src/**/*.{ts,tsx}", "server/**/*.ts", "tools/**/*.ts", "features/**/*.{ts,tsx}", "*.ts"],
  "ignoreDependencies": {{if .plugins.lakebase}}["@ast-grep/napi", "@tailwindcss/postcss", "autoprefixer", "tw-animate-css"]{{else}}[
    "@ast-grep/napi",
    "@tailwindcss/postcss",
    "autoprefixer",
    "tw-animate-css",
    "@electric-sql/pglite",
    "@electric-sql/pglite-socket"
  ]{{end}}
}
